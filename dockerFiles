# Use a lightweight official OpenJDK JRE base image.
FROM openjdk:17-jre-slim

# Set the working directory inside the container.
WORKDIR /app

# Define a build-time argument for the JAR file path.
# The default value is `target/dbe-0.0.1-SNAPSHOT.jar`.
ARG JAR_FILE=target/dbe-0.0.1-SNAPSHOT.jar

# Copy the JAR file from the host machine to the container.
# The argument is used for the source path, and the destination
# is a fixed filename in the container.
COPY ${JAR_FILE} app.jar

# Define the command to execute the JAR file when the container starts.
ENTRYPOINT ["java", "-jar", "app.jar"]

# Expose the port your application listens on.
EXPOSE 8083